{
  "name": "tourism-info-system-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BACSE202 Tourism Information System backend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:db": "node --env-file=.env scripts/check-db.js",
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "setup:db": "node --env-file=.env scripts/setup-db.js",
    "test": "node --env-file=.env --test --test-concurrency=1 test/integration.test.js"
  },
  "dependencies": {
    "oracledb": "6.10.0",
    "express": "5.2.1",
    "cors": "2.8.6"
  }
}
